[Unit]
Description=Check host storage, backup health and SSH access rules

[Service]
Type=oneshot
EnvironmentFile=-/etc/moonlight/backup.env
ExecStart=/usr/local/sbin/moonlight-host-check
StateDirectory=moonlight/alerts
StateDirectoryMode=0700
ProtectSystem=strict
ReadWritePaths=/var/lib/moonlight/alerts
ProtectHome=true
PrivateTmp=true

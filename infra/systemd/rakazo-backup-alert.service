[Unit]
Description=Notify operators when a production backup fails

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/moonlight-host-alert backup-failure "Nightly backup failed. Inspect moonlight-backup.service on the server."
StateDirectory=moonlight/alerts
StateDirectoryMode=0700
ProtectSystem=strict
ReadWritePaths=/var/lib/moonlight/alerts
PrivateTmp=true
